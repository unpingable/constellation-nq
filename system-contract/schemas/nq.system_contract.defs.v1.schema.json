{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.system_contract.defs.v1.schema.json",
  "title": "NQ system-contract v1 shared definitions",
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u034f\\u061c\\u115f-\\u1160\\u17b4-\\u17b5\\u180b-\\u180f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\u3164\\ufe00-\\ufe0f\\ufeff\\uffa0]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "positiveCanonicalU32String": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$"
    },
    "authority": {
      "const": "none"
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot_id",
        "kind",
        "content_digest",
        "captured_at",
        "provenance"
      ],
      "properties": {
        "source_snapshot_id": {"$ref": "#/$defs/token"},
        "kind": {
          "enum": [
            "bootstrap_target",
            "netbox_inventory",
            "operator_authored",
            "other_declared_facts"
          ]
        },
        "content_digest": {"$ref": "#/$defs/digest"},
        "captured_at": {"$ref": "#/$defs/timestamp"},
        "provenance": {"$ref": "#/$defs/boundedText"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_class",
        "target_identity_digest",
        "source_snapshot_ids"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/token"},
        "target_class": {"$ref": "#/$defs/token"},
        "target_identity_digest": {"$ref": "#/$defs/digest"},
        "source_snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "kind", "hosted_on", "source_snapshot_ids"],
      "properties": {
        "component_id": {"$ref": "#/$defs/token"},
        "kind": {"$ref": "#/$defs/token"},
        "hosted_on": {"$ref": "#/$defs/token"},
        "source_snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "consumer_component_id",
        "provider_component_id",
        "requirement",
        "source_snapshot_ids"
      ],
      "properties": {
        "dependency_id": {"$ref": "#/$defs/token"},
        "consumer_component_id": {"$ref": "#/$defs/token"},
        "provider_component_id": {"$ref": "#/$defs/token"},
        "requirement": {"enum": ["required", "incidental"]},
        "source_snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "version": {"$ref": "#/$defs/positiveCanonicalU32String"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"$ref": "#/$defs/token"},
        "value": {
          "$comment": "Profile-owned opaque object, byte-bounded and validated by the compiled Rust profile.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {".*": {}}
        }
      }
    },
    "vantageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"$ref": "#/$defs/token"},
        "value": {
          "$comment": "Profile-owned opaque object, byte-bounded and validated by the compiled Rust profile.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {".*": {}}
        }
      }
    },
    "subjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "scope", "vantage"],
      "properties": {
        "subject": {"$ref": "#/$defs/token"},
        "scope": {"$ref": "#/$defs/scopeBinding"},
        "vantage": {"$ref": "#/$defs/vantageBinding"}
      }
    },
    "observationObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_obligation_id",
        "component_id",
        "instance_id",
        "profile",
        "subject_binding",
        "required_coverage",
        "granted_capabilities",
        "freshness_seconds",
        "source_snapshot_ids"
      ],
      "properties": {
        "observation_obligation_id": {"$ref": "#/$defs/token"},
        "component_id": {"$ref": "#/$defs/token"},
        "instance_id": {"$ref": "#/$defs/token"},
        "profile": {"$ref": "#/$defs/profile"},
        "subject_binding": {"$ref": "#/$defs/subjectBinding"},
        "required_coverage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        },
        "granted_capabilities": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        },
        "freshness_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31622400
        },
        "source_snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "systemDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "title",
        "target_ids",
        "component_ids",
        "dependency_ids",
        "observation_obligation_ids",
        "source_snapshot_ids"
      ],
      "properties": {
        "system_id": {"$ref": "#/$defs/token"},
        "title": {"$ref": "#/$defs/boundedText"},
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        },
        "dependency_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        },
        "observation_obligation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        },
        "source_snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "systemSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "spec_id",
        "revision",
        "title",
        "source_snapshots",
        "targets",
        "components",
        "dependencies",
        "observation_obligations",
        "systems",
        "authority"
      ],
      "properties": {
        "schema": {"const": "nq.system_spec.v1"},
        "spec_id": {"$ref": "#/$defs/token"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "title": {"$ref": "#/$defs/boundedText"},
        "source_snapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceSnapshot"}
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/component"}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "observation_obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/observationObligation"}
        },
        "systems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/systemDefinition"}
        },
        "authority": {"$ref": "#/$defs/authority"}
      }
    },
    "ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratified_by",
        "ratified_at",
        "ratified_proposal_digest",
        "ratification_record_digest"
      ],
      "properties": {
        "ratified_by": {"$ref": "#/$defs/token"},
        "ratified_at": {"$ref": "#/$defs/timestamp"},
        "ratified_proposal_digest": {"$ref": "#/$defs/digest"},
        "ratification_record_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "systemSpecReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id", "revision", "spec_digest"],
      "properties": {
        "spec_id": {"$ref": "#/$defs/token"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "spec_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scopeCutReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cut_id", "cut_digest"],
      "properties": {
        "cut_id": {"$ref": "#/$defs/token"},
        "cut_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scopeCutProposalBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cut_id",
        "source_spec",
        "system",
        "source_snapshots",
        "targets",
        "components",
        "dependencies",
        "observation_obligations",
        "authority"
      ],
      "properties": {
        "cut_id": {"$ref": "#/$defs/token"},
        "source_spec": {"$ref": "#/$defs/systemSpecReference"},
        "system": {"$ref": "#/$defs/systemDefinition"},
        "source_snapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceSnapshot"}
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/component"}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "observation_obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/observationObligation"}
        },
        "authority": {"$ref": "#/$defs/authority"}
      }
    },
    "scopeCutProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "proposal_digest", "proposal"],
      "properties": {
        "schema": {"const": "nq.scope_cut_proposal.v1"},
        "proposal_digest": {"$ref": "#/$defs/digest"},
        "proposal": {"$ref": "#/$defs/scopeCutProposalBody"}
      }
    },
    "scopeCutBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cut_id",
        "source_spec",
        "ratification",
        "system",
        "source_snapshots",
        "targets",
        "components",
        "dependencies",
        "observation_obligations",
        "authority"
      ],
      "properties": {
        "cut_id": {"$ref": "#/$defs/token"},
        "source_spec": {"$ref": "#/$defs/systemSpecReference"},
        "ratification": {"$ref": "#/$defs/ratification"},
        "system": {"$ref": "#/$defs/systemDefinition"},
        "source_snapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceSnapshot"}
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/component"}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "observation_obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/observationObligation"}
        },
        "authority": {"$ref": "#/$defs/authority"}
      }
    },
    "publishedScopeCut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "cut_digest", "cut"],
      "properties": {
        "schema": {"const": "nq.scope_cut.v1"},
        "cut_digest": {"$ref": "#/$defs/digest"},
        "cut": {"$ref": "#/$defs/scopeCutBody"}
      }
    },
    "nqObservationProjectionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "scope_cut",
        "system_id",
        "targets",
        "components",
        "dependencies",
        "observation_obligations",
        "authority"
      ],
      "properties": {
        "projection_id": {"$ref": "#/$defs/token"},
        "scope_cut": {"$ref": "#/$defs/scopeCutReference"},
        "system_id": {"$ref": "#/$defs/token"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/component"}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "observation_obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/observationObligation"}
        },
        "authority": {"$ref": "#/$defs/authority"}
      }
    },
    "nqObservationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "projection_digest", "projection"],
      "properties": {
        "schema": {"const": "nq.observation_projection.v1"},
        "projection_digest": {"$ref": "#/$defs/digest"},
        "projection": {"$ref": "#/$defs/nqObservationProjectionBody"}
      }
    },
    "porterActuationProjectionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "scope_cut",
        "system_id",
        "actuation_targets",
        "actuation_components",
        "affected_targets",
        "affected_components",
        "boundary_dependencies",
        "verification_obligations",
        "authority"
      ],
      "properties": {
        "projection_id": {"$ref": "#/$defs/token"},
        "scope_cut": {"$ref": "#/$defs/scopeCutReference"},
        "system_id": {"$ref": "#/$defs/token"},
        "actuation_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        },
        "actuation_components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/component"}
        },
        "affected_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        },
        "affected_components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/component"}
        },
        "boundary_dependencies": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "verification_obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/observationObligation"}
        },
        "authority": {"$ref": "#/$defs/authority"}
      }
    },
    "porterActuationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "projection_digest", "projection"],
      "properties": {
        "schema": {"const": "nq.porter_actuation_projection.v1"},
        "projection_digest": {"$ref": "#/$defs/digest"},
        "projection": {"$ref": "#/$defs/porterActuationProjectionBody"}
      }
    }
  }
}
