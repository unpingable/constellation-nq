[Unit]
Description=NQ-ng finite passive host-load observer generation
Documentation=file:///usr/share/doc/nq-ng/docs/PASSIVE_LOAD_OPERATIONAL_CONTINUITY_V1.md
After=local-fs.target
RequiresMountsFor=/var/lib/nq-passive-load

[Service]
Type=simple
User=nq-passive-load-observer
Group=nq-passive-load-reader
UMask=0027
WorkingDirectory=/usr
ExecStart=/usr/lib/nq/helpers/nq-passive-load-helper observe-generation /etc/nq/passive-load-operational-policy.json /etc/nq/passive-load-observer-generation.json
# Restart recovers only the exact still-active immutable generation. The helper
# exits successfully for exhaustion, pause, retirement, or key revocation, so
# restart cannot mint or extend sampling authority.
Restart=on-failure
RestartSec=10s

# The sampler needs no network, shell, device, privilege, or arbitrary command
# surface. Deliberately do not set CPUQuota, CPUAffinity, or AllowedCPUs: those
# would change the exact available_parallelism() capacity context.
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/nq/passive-load-operational-policy.json /etc/nq/passive-load-observer-generation.json /var/lib/nq-passive-load/keys
ReadWritePaths=/var/lib/nq-passive-load/samples
LimitNOFILE=64
LimitFSIZE=64K
LimitCORE=0
TasksMax=4
MemoryMax=64M
MemorySwapMax=0
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nq-passive-load-observer

# Deliberately no [Install] section. Package installation and service-manager
# state create no generation, signing key, sample, or diagnostic authority.
