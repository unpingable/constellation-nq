#!/bin/sh
set -eu

ensure_account_fallback() {
    if ! getent group nq >/dev/null 2>&1; then
        addgroup --system nq
    fi
    if ! getent passwd nq >/dev/null 2>&1; then
        shell=/usr/sbin/nologin
        if [ ! -x "$shell" ]; then
            shell=/bin/false
        fi
        adduser \
            --system \
            --ingroup nq \
            --home /var/lib/nq \
            --no-create-home \
            --shell "$shell" \
            nq
    fi
    if ! getent group nq-helper >/dev/null 2>&1; then
        addgroup --system nq-helper
    fi
    if ! getent passwd nq-helper >/dev/null 2>&1; then
        shell=/usr/sbin/nologin
        if [ ! -x "$shell" ]; then
            shell=/bin/false
        fi
        adduser \
            --system \
            --ingroup nq-helper \
            --home /nonexistent \
            --no-create-home \
            --shell "$shell" \
            nq-helper
    fi
    if ! getent group nq-origin-helper >/dev/null 2>&1; then
        addgroup --system nq-origin-helper
    fi
    if ! getent passwd nq-origin-helper >/dev/null 2>&1; then
        shell=/usr/sbin/nologin
        if [ ! -x "$shell" ]; then
            shell=/bin/false
        fi
        adduser \
            --system \
            --ingroup nq-origin-helper \
            --home /var/lib/nq-origin-helper \
            --no-create-home \
            --shell "$shell" \
            nq-origin-helper
    fi
    if ! getent group nq-passive-load-observer >/dev/null 2>&1; then
        addgroup --system nq-passive-load-observer
    fi
    if ! getent passwd nq-passive-load-observer >/dev/null 2>&1; then
        shell=/usr/sbin/nologin
        if [ ! -x "$shell" ]; then
            shell=/bin/false
        fi
        adduser \
            --system \
            --ingroup nq-passive-load-observer \
            --home /var/lib/nq-passive-load \
            --no-create-home \
            --shell "$shell" \
            nq-passive-load-observer
    fi
    if ! getent group nq-passive-load-reader >/dev/null 2>&1; then
        addgroup --system nq-passive-load-reader
    fi
    if ! getent passwd nq-passive-load-reader >/dev/null 2>&1; then
        shell=/usr/sbin/nologin
        if [ ! -x "$shell" ]; then
            shell=/bin/false
        fi
        adduser \
            --system \
            --ingroup nq-passive-load-reader \
            --home /nonexistent \
            --no-create-home \
            --shell "$shell" \
            nq-passive-load-reader
    fi
}

create_layout_fallback() {
    install -d -o root -g nq -m 0750 /etc/nq
    install -d -o nq -g nq -m 0700 \
        /var/lib/nq \
        /var/lib/nq/admissions \
        /var/lib/nq/backups
    install -d -o nq-origin-helper -g nq-origin-helper -m 0700 \
        /var/lib/nq-origin-helper
    install -d -o nq-passive-load-observer -g nq-passive-load-reader -m 0750 \
        /var/lib/nq-passive-load
    install -d -o nq-passive-load-observer -g nq-passive-load-reader -m 2750 \
        /var/lib/nq-passive-load/samples
    install -d -o nq -g nq -m 0751 /run/nq
    install -d -o nq -g nq -m 0711 /run/nq/helpers
}

case "${1:-}" in
    configure|abort-upgrade|abort-remove|abort-deconfigure)
        if command -v systemd-sysusers >/dev/null 2>&1; then
            systemd-sysusers /usr/lib/sysusers.d/nq.conf
        else
            ensure_account_fallback
        fi

        if command -v systemd-tmpfiles >/dev/null 2>&1; then
            systemd-tmpfiles --create /usr/lib/tmpfiles.d/nq.conf
        else
            create_layout_fallback
        fi

        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi
        ;;
esac

# Deliberately absent: nq init, nq admin upgrade, config installation,
# systemctl enable, and systemctl start. Each requires an operator decision.
exit 0
