{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.c2_g_reservation.v1.json",
  "title": "nq.c2_g_reservation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "reservation_identity",
    "occurrence_id",
    "physical_store_generation_identity",
    "signer_lifecycle_root_identity",
    "scope_identity",
    "resident_identity",
    "resident_generation",
    "host_role",
    "role_manifest_generation",
    "authority_domain",
    "signer_scope_policy_identity",
    "signer_scope_policy_version",
    "active_store_policy_identity",
    "g_root_identity",
    "g_cursor",
    "reserved_slot",
    "reservation_state",
    "reserved_before_candidate_effect",
    "reservation_cut"
  ],
  "properties": {
    "schema": {
      "const": "nq.c2_g_reservation.v1"
    },
    "schema_version": {
      "const": 1
    },
    "reservation_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "physical_store_generation_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_lifecycle_root_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "resident_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "host_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "role_manifest_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "authority_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "signer_scope_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_scope_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "active_store_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "g_root_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "g_cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reserved_slot": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "reservation_state": {
      "enum": [
        "reserved",
        "released",
        "consumed_failure"
      ]
    },
    "reserved_before_candidate_effect": {
      "const": true
    },
    "reservation_cut": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
