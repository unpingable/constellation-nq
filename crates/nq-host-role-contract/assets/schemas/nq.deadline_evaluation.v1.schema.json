{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.deadline_evaluation.v1.schema.json",
  "title": "nq.deadline_evaluation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluation_id",
    "namespace",
    "outer_request",
    "activation",
    "clock_qualification",
    "clock",
    "request_bounds",
    "bracket_policy",
    "sample",
    "derived",
    "decision",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "nq.deadline_evaluation.v1"
    },
    "evaluation_id": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
    },
    "namespace": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/namespaceSnapshot"
    },
    "outer_request": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/diagnosticInvocationRequestReference"
    },
    "activation": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/runtimeActivationReference"
    },
    "clock_qualification": {
      "$ref": "#/$defs/clockQualificationReference"
    },
    "clock": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/clockIdentityReference"
    },
    "request_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_before",
        "deadline",
        "maximum_execution_ms"
      ],
      "properties": {
        "not_before": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
        },
        "deadline": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
        },
        "maximum_execution_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "bracket_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "maximum_width_ns"
      ],
      "properties": {
        "policy": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/policyIdentityReference"
        },
        "maximum_width_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realtime_before",
        "boottime_at_ns",
        "realtime_after",
        "bracket_width_ns",
        "boot_epoch"
      ],
      "properties": {
        "realtime_before": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
        },
        "boottime_at_ns": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "realtime_after": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
        },
        "bracket_width_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "boot_epoch": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launched_at",
        "attempt_deadline",
        "boottime_expiry_ns"
      ],
      "properties": {
        "launched_at": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
        },
        "attempt_deadline": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
        },
        "boottime_expiry_ns": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "violations"
      ],
      "properties": {
        "state": {
          "enum": [
            "accepted",
            "refused"
          ]
        },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "realtime_bracket_reversed",
              "invalid_request_window",
              "bracket_too_wide",
              "before_not_before",
              "request_deadline_exhausted",
              "execution_budget_exceeds_request_deadline"
            ]
          }
        }
      }
    },
    "nonclaims": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/nonclaims"
    }
  },
  "$defs": {
    "clockQualificationReference": {
      "allOf": [
        {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
        },
        {
          "properties": {
            "schema": {
              "const": "nq.native_clock_qualification.v1"
            }
          }
        }
      ]
    }
  }
}
