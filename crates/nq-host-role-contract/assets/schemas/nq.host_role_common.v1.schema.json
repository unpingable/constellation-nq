    "namespaceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace_id",
        "namespace_version",
        "catalog_generation",
        "catalog_id"
      ],
      "properties": {
        "namespace_id": {
          "const": "nq.production"
        },
        "namespace_version": {
          "const": "1"
        },
        "catalog_generation": {
          "$ref": "#/$defs/generation"
        },
        "catalog_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "effectiveInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_from"
      ],
      "properties": {
        "effective_from": {
          "$ref": "#/$defs/timestamp"
        },
        "effective_until": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
