              "const": "clock"
            }
          }
        }
      ]
    },
    "recordReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "record_id",
        "bytes_digest"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/token"
        },
        "record_id": {
          "$ref": "#/$defs/digest"
        },
        "bytes_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "hostRoleRelationReference": {
      "allOf": [
        {
          "$ref": "#/$defs/recordReference"
        },
        {
