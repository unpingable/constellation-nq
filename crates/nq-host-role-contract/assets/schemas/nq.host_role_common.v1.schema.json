{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.host_role_common.v1.schema.json",
  "title": "NQ host-role common definitions v1",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._:/@+-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "identityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "descriptor_digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"
        },
        "descriptor_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "nqNodeIdentityReference": {
      "allOf": [
        {
          "$ref": "#/$defs/identityReference"
        },
        {
          "properties": {
            "kind": {
              "const": "nq_node"
            }
          }
        }
      ]
    },
    "subjectIdentityReference": {
      "allOf": [
        {
          "$ref": "#/$defs/identityReference"
        },
        {
          "properties": {
            "kind": {
              "const": "subject"
            }
          }
        }
      ]
    },
    "platformIdentityReference": {
      "allOf": [
        {
          "$ref": "#/$defs/identityReference"
        },
        {
          "properties": {
            "kind": {
