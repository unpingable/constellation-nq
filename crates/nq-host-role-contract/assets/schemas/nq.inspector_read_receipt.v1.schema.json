{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.inspector_read_receipt.v1.schema.json",
  "title": "nq.inspector_read_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "query_occurrence_id",
    "query_digest",
    "requesting_principal",
    "authentication_evidence",
    "sensitive_read_authorization",
    "access_policy",
    "decision",
    "decision_reason",
    "decided_at",
    "page_response",
    "retrieved_records",
    "page_response_digest",
    "page_response_bytes",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "nq.inspector_read_receipt.v1"
    },
    "receipt_id": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
    },
    "query_occurrence_id": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/token"
    },
    "query_digest": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
    },
    "requesting_principal": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
    },
    "authentication_evidence": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
    },
    "sensitive_read_authorization": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/authorizationReference"
        }
      ]
    },
    "access_policy": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
    },
    "decision": {
      "enum": [
        "granted",
        "refused"
      ]
    },
    "decision_reason": {
      "enum": [
        "authorized",
        "authentication_refused",
        "authorization_refused",
        "scope_mismatch",
        "authorization_expired",
        "policy_refused"
      ]
    },
    "decided_at": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
    },
    "page_response": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/pageResponseReference"
        }
      ]
    },
    "retrieved_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
      }
    },
    "page_response_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
        }
      ]
    },
    "page_response_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonclaims": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/nonclaims"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "granted"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "decision_reason": {
            "const": "authorized"
          },
          "sensitive_read_authorization": {
            "$ref": "#/$defs/authorizationReference"
          },
          "page_response": {
            "$ref": "#/$defs/pageResponseReference"
          },
          "page_response_digest": {
            "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
          }
        }
      },
      "else": {
        "properties": {
          "decision_reason": {
            "enum": [
              "authentication_refused",
              "authorization_refused",
              "scope_mismatch",
              "authorization_expired",
              "policy_refused"
            ]
          },
          "page_response": {
            "type": "null"
          },
          "retrieved_records": {
            "maxItems": 0
          },
          "page_response_digest": {
            "type": "null"
          },
          "page_response_bytes": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_reason": {
            "const": "authentication_refused"
          }
        },
        "required": [
          "decision_reason"
        ]
      },
      "then": {
        "properties": {
          "sensitive_read_authorization": {
            "type": "null"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "decision": {
              "const": "refused"
            }
          },
          "required": [
            "decision"
          ]
        },
        "then": {
          "properties": {
            "sensitive_read_authorization": {
              "$ref": "#/$defs/authorizationReference"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "authorizationReference": {
      "allOf": [
        {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
        },
        {
          "properties": {
            "schema": {
              "const": "nq.operation_authorization.v1"
            }
          }
        }
      ]
    },
    "pageResponseReference": {
      "allOf": [
        {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
        },
        {
          "properties": {
            "schema": {
              "const": "nq.inspector_snapshot.v1"
            }
          }
        }
      ]
    }
  }
}
