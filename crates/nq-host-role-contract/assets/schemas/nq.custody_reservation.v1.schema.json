{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.custody_reservation.v1.schema.json",
  "title": "nq.custody_reservation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reservation_id",
    "namespace",
    "node",
    "request",
    "activation",
    "profile",
    "custody_policy",
    "delivery_requirement",
    "store_snapshot",
    "calculation_rule",
    "component_bounds",
    "total_required_bytes",
    "reserved_bytes",
    "protected_failure_reserve_bytes",
    "decision",
    "reservation_commit",
    "reserved_at",
    "expires_at",
    "clock",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "nq.custody_reservation.v1"
    },
    "reservation_id": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
    },
    "namespace": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/namespaceSnapshot"
    },
    "node": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
    },
    "request": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
    },
    "activation": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
    },
    "profile": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
    },
    "custody_policy": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
    },
    "delivery_requirement": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
        }
      ]
    },
    "store_snapshot": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
    },
    "calculation_rule": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
    },
    "component_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_and_decision_bytes",
        "raw_evidence_bytes",
        "normalized_bytes",
        "projected_bytes",
        "diagnostic_artifact_bytes",
        "dependency_closure_bytes",
        "commit_checkpoint_overhead_bytes",
        "mandatory_delivery_ledger_bytes"
      ],
      "properties": {
        "request_and_decision_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "raw_evidence_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "normalized_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "projected_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "diagnostic_artifact_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "dependency_closure_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "commit_checkpoint_overhead_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "mandatory_delivery_ledger_bytes": {
          "$ref": "#/$defs/bytes"
        }
      }
    },
    "total_required_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reserved_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "protected_failure_reserve_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "decision": {
      "enum": [
        "reserved",
        "refused"
      ]
    },
    "reservation_commit": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
    },
    "reserved_at": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
    },
    "clock": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
    },
    "nonclaims": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/nonclaims"
    }
  },
  "$defs": {
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
