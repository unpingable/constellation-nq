{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.inspector_snapshot.v1.schema.json",
  "title": "nq.inspector_snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "page_response_id",
    "snapshot",
    "snapshot_id",
    "query_digest",
    "created_at",
    "page",
    "cursor",
    "canonical_records",
    "projections",
    "ephemeral_observations",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "nq.inspector_snapshot.v1"
    },
    "page_response_id": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
    },
    "snapshot": {
      "$ref": "#/$defs/resultSetReference"
    },
    "snapshot_id": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
    },
    "query_digest": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
    },
    "created_at": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cursor"
        }
      ]
    },
    "canonical_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projection"
      }
    },
    "ephemeral_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ephemeralObservation"
      }
    },
    "nonclaims": {
      "$ref": "nq.host_role_common.v1.schema.json#/$defs/nonclaims"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "page": {
            "properties": {
              "has_more": {
                "const": true
              }
            },
            "required": [
              "has_more"
            ]
          }
        },
        "required": [
          "page"
        ]
      },
      "then": {
        "properties": {
          "cursor": {
            "$ref": "#/$defs/cursor"
          }
        }
      },
      "else": {
        "properties": {
          "cursor": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "resultSetReference": {
      "allOf": [
        {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
        },
        {
          "properties": {
            "schema": {
              "const": "nq.inspector_result_set.v1"
            }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "offset",
        "size",
        "returned_count",
        "has_more"
      ],
      "properties": {
        "number": {
          "$ref": "#/$defs/positiveInteger"
        },
        "offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "size": {
          "$ref": "#/$defs/positiveInteger"
        },
        "returned_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "has_more": {
          "type": "boolean"
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor_id",
        "snapshot_id",
        "query_digest",
        "next_page",
        "next_offset",
        "page_size",
        "expires_at"
      ],
      "properties": {
        "cursor_id": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/token"
        },
        "snapshot_id": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
        },
        "query_digest": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
        },
        "next_page": {
          "$ref": "#/$defs/positiveInteger"
        },
        "next_offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "page_size": {
          "$ref": "#/$defs/positiveInteger"
        },
        "expires_at": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "sources",
        "evaluator",
        "semantics"
      ],
      "properties": {
        "kind": {
          "enum": [
            "canonical_record_availability",
            "canonical_digest_verification",
            "reference_resolution",
            "role_slot_attachment",
            "delivery_tracking"
          ]
        },
        "value": {
          "enum": [
            "online",
            "committed_unavailable",
            "missing_bytes",
            "corrupt",
            "verified",
            "mismatch",
            "unavailable",
            "resolved",
            "missing",
            "unsupported_schema",
            "filled",
            "unfilled",
            "attachment_refused",
            "attachment_retired",
            "not_required",
            "export_committed",
            "queued",
            "attempt_in_progress",
            "retry_scheduled",
            "delivery_ambiguous",
            "acknowledged_custody",
            "terminal_rejected",
            "attempts_exhausted",
            "blocked_backpressure"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/projectionSource"
          }
        },
        "evaluator": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
        },
        "semantics": {
          "const": "mechanical_read_projection_only"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "canonical_record_availability"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": "online"
              },
              "sources": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "pointer": {
                      "const": ""
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "canonical_digest_verification"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": "verified"
              },
              "sources": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "pointer": {
                      "const": ""
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reference_resolution"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "resolved",
                  "missing",
                  "unsupported_schema"
                ]
              },
              "sources": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "role_slot_attachment"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "filled",
                  "attachment_retired"
                ]
              },
              "sources": {
                "minItems": 3,
                "maxItems": 3,
                "prefixItems": [
                  {
                    "properties": {
                      "record": {
                        "properties": {
                          "schema": {
                            "const": "nq.role_manifest.v1"
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "record": {
                        "properties": {
                          "schema": {
                            "const": "nq.witness_attachment.v1"
                          }
                        }
                      },
                      "pointer": {
                        "const": "/role_slot"
                      }
                    }
                  },
                  {
                    "properties": {
                      "record": {
                        "properties": {
                          "schema": {
                            "const": "nq.witness_lifecycle_event.v1"
                          }
                        }
                      },
                      "pointer": {
                        "const": "/to_state"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "delivery_tracking"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "not_required",
                  "export_committed",
                  "queued",
                  "attempt_in_progress",
                  "retry_scheduled",
                  "delivery_ambiguous",
                  "acknowledged_custody",
                  "terminal_rejected",
                  "attempts_exhausted",
                  "blocked_backpressure",
                  "committed_unavailable"
                ]
              },
              "sources": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "record": {
                      "properties": {
                        "schema": {
                          "const": "nq.artifact_delivery_record.v1"
                        }
                      }
                    },
                    "pointer": {
                      "const": "/state"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "projectionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "pointer"
      ],
      "properties": {
        "record": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/recordReference"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(|/.*)$"
        }
      }
    },
    "ephemeralObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "kind",
        "observed_at",
        "source",
        "detail_code",
        "nonclaims"
      ],
      "properties": {
        "observation_id": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/digest"
        },
        "kind": {
          "enum": [
            "runtime_process_reachable",
            "runtime_process_unreachable",
            "index_rebuild_in_progress",
            "store_read_error",
            "buffer_read_error",
            "transport_read_error"
          ]
        },
        "observed_at": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/timestamp"
        },
        "source": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/identityReference"
        },
        "detail_code": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/token"
        },
        "nonclaims": {
          "$ref": "nq.host_role_common.v1.schema.json#/$defs/nonclaims"
        }
      }
    }
  }
}
