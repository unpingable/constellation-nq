[Unit]
Description=NQ transactionally gated finite recurrence (reviewed 24h charter)
After=local-fs.target
RequiresMountsFor=/var/lib/nq-passive-load

[Service]
Type=oneshot
User=nq
Group=nq
SupplementaryGroups=nq-evidence nq-passive-load-reader
UMask=0027
WorkingDirectory=/
ExecStart=/opt/nq-ng/passive-handoff-87a6ca3-musl/bin/nq --config /etc/nq/passive-load-24h-r2/nq-charter.toml --json operating tick-grant sha256:13dd77121ce3786cf967a4e0e98993e1639dc94612cdb17ce5309d49ba8df06d --state-dir /var/lib/nq-passive-load/charter-24h-r2/operating
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/nq/passive-load-24h-r2 /etc/nq-ng-observation-office/origin-helper-public-key.hex /opt/nq-ng/passive-handoff-87a6ca3-musl /opt/nq-ng/linode-v3-20260824
ReadWritePaths=/var/lib/nq-passive-load/charter-24h-r2 /var/lib/nq-passive-load/samples /run/nq-passive-load-24h-r2
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=169.254.169.254/32
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LimitNOFILE=4096
LimitFSIZE=1G
LimitCORE=0
TasksMax=64
MemoryMax=1G
MemorySwapMax=0
TimeoutStartSec=90s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nq-passive-24h-r2-recurrence
