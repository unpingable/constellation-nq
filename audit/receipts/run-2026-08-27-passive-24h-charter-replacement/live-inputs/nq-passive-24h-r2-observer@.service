[Unit]
Description=NQ finite passive-load observer generation %i (reviewed 24h charter)
After=local-fs.target
RequiresMountsFor=/var/lib/nq-passive-load

[Service]
Type=simple
# Template instances otherwise enter an automatic per-template slice. That
# nested cgroup omits the exact cpu.max/cpuset files bound by this deployment's
# qualified available_parallelism() context. Keep every finite instance in the
# already-qualified direct system slice; this selects no CPU quota or affinity.
Slice=system.slice
User=nq-passive-load-observer
Group=nq-passive-load-reader
UMask=0027
WorkingDirectory=/opt/nq-ng/passive-handoff-87a6ca3-musl
ExecStart=/opt/nq-ng/passive-handoff-87a6ca3-musl/lib/nq/helpers/nq-passive-load-helper observe-generation /etc/nq/passive-load-24h-r2/observer-policy.json /etc/nq/passive-load-24h-r2/control/%i-generation.json
Restart=on-failure
RestartSec=10s
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/nq/passive-load-24h-r2 /var/lib/nq-passive-load/keys
ReadWritePaths=/var/lib/nq-passive-load/samples
LimitNOFILE=64
LimitFSIZE=64K
LimitCORE=0
TasksMax=4
MemoryMax=64M
MemorySwapMax=0
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nq-passive-24h-r2-observer-%i
