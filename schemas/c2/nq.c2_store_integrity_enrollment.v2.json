{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.c2_store_integrity_enrollment.v2.json",
  "title": "nq.c2_store_integrity_enrollment.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "identity_domain",
    "enrollment_identity",
    "foundational_enrollment_identity",
    "candidate_identity",
    "pop_identity",
    "attempt_identity",
    "accepted_cut"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "properties": {
    "schema": {
      "const": "nq.c2_store_integrity_enrollment.v2"
    },
    "schema_version": {
      "const": 2
    },
    "identity_domain": {
      "const": "nq.c2.store_integrity_enrollment.identity.v2"
    },
    "enrollment_identity": {
      "$ref": "#/$defs/digest"
    },
    "foundational_enrollment_identity": {
      "$ref": "#/$defs/digest"
    },
    "candidate_identity": {
      "$ref": "#/$defs/digest"
    },
    "pop_identity": {
      "$ref": "#/$defs/digest"
    },
    "attempt_identity": {
      "$ref": "#/$defs/digest"
    },
    "accepted_cut": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
