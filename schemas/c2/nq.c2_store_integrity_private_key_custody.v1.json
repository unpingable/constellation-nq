{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.c2_store_integrity_private_key_custody.v1.json",
  "title": "nq.c2_store_integrity_private_key_custody.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "proposal_core_identity",
    "proposal_identity",
    "proposal_ordinal",
    "scope_token",
    "occurrence_id",
    "physical_store_generation_identity",
    "signer_lifecycle_root_identity",
    "scope_identity",
    "resident_identity",
    "resident_generation",
    "host_role",
    "role_manifest_generation",
    "authority_domain",
    "signer_scope_policy_identity",
    "signer_scope_policy_version",
    "proposed_key_generation",
    "algorithm",
    "public_key",
    "custody_nonce",
    "scope_directory_identity",
    "custody_file_device",
    "custody_file_mount",
    "custody_file_inode",
    "owner_uid",
    "owner_gid",
    "mode",
    "link_count",
    "magic",
    "private_seed",
    "custodian_implementation_manifest_identity",
    "payload_digest"
  ],
  "properties": {
    "schema": {
      "const": "nq.c2_store_integrity_private_key_custody.v1"
    },
    "schema_version": {
      "const": 1
    },
    "proposal_core_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "proposal_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "proposal_ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "scope_token": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "physical_store_generation_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_lifecycle_root_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "host_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "role_manifest_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "authority_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "signer_scope_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_scope_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "proposed_key_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "algorithm": {
      "const": "ed25519_store_integrity_v1"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "custody_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_directory_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "custody_file_device": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "custody_file_mount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "custody_file_inode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "owner_uid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "owner_gid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mode": {
      "const": "0400"
    },
    "link_count": {
      "const": 1
    },
    "magic": {
      "const": "NQC2SIK1"
    },
    "private_seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "custodian_implementation_manifest_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
