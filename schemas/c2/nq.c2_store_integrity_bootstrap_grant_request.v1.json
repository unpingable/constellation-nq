{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.c2_store_integrity_bootstrap_grant_request.v1.json",
  "title": "nq.c2_store_integrity_bootstrap_grant_request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "grant_request_identity",
    "interpretation_policy",
    "issuer_a1_digest",
    "issuer_a1_key_generation",
    "issuer_a1_verification_key",
    "issuer_operator_principal",
    "issuer_domain",
    "issuer_permitted_scope",
    "issuer_policy_version",
    "issuer_policy_floor",
    "issued_against_gen4_cut",
    "issued_against_gen4_terminal_event",
    "issued_against_candidate_set",
    "occurrence_id",
    "a2_chain_root",
    "controlling_activation",
    "resident_identity",
    "resident_generation",
    "host_role",
    "role_manifest_generation",
    "trust_anchor_id",
    "authority_domain",
    "activation_policy_version",
    "proposal_identity",
    "custody_instance_identity",
    "store_integrity_key_algorithm",
    "store_integrity_public_key",
    "store_integrity_key_generation",
    "signer_scope_policy_identity",
    "signer_scope_policy_version",
    "permitted_bootstrap_families",
    "installation_mode",
    "installed_policy_calculation_identity",
    "c2_lifecycle_cut",
    "predecessor_c2_lifecycle_event",
    "expiry"
  ],
  "properties": {
    "schema": {
      "const": "nq.c2_store_integrity_bootstrap_grant_request.v1"
    },
    "schema_version": {
      "const": 1
    },
    "grant_request_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "interpretation_policy": {
      "const": "nq.c2.a1_runtime_dependency_admission_refinement.v1"
    },
    "issuer_a1_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuer_a1_key_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issuer_a1_verification_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuer_operator_principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "issuer_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "issuer_permitted_scope": {
      "const": "runtime_dependency_admission"
    },
    "issuer_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issuer_policy_floor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issued_against_gen4_cut": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "issued_against_gen4_terminal_event": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issued_against_candidate_set": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "a2_chain_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "controlling_activation": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "resident_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "host_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "role_manifest_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "trust_anchor_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "activation_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "proposal_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "custody_instance_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "store_integrity_key_algorithm": {
      "const": "ed25519_store_integrity_v1"
    },
    "store_integrity_public_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "store_integrity_key_generation": {
      "const": 0
    },
    "signer_scope_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_scope_policy_version": {
      "const": 1
    },
    "permitted_bootstrap_families": {
      "const": [
        "physical_store_generation_genesis",
        "store_generation_installation_intent",
        "store_generation_installation_receipt"
      ]
    },
    "installation_mode": {
      "enum": [
        "fresh",
        "restore_successor"
      ]
    },
    "installed_policy_calculation_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "c2_lifecycle_cut": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "predecessor_c2_lifecycle_event": {
      "type": "null"
    },
    "expiry": {
      "type": "null"
    }
  }
}
