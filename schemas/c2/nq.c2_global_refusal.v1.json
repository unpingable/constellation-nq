{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.c2_global_refusal.v1.json",
  "title": "nq.c2_global_refusal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "refusal_identity",
    "occurrence_id",
    "physical_store_generation_identity",
    "signer_lifecycle_root_identity",
    "scope_identity",
    "resident_identity",
    "resident_generation",
    "host_role",
    "role_manifest_generation",
    "authority_domain",
    "signer_scope_policy_identity",
    "signer_scope_policy_version",
    "active_store_policy_identity",
    "predecessor_g_root_identity",
    "predecessor_g_cursor",
    "failure_class",
    "bounded_canonical_failure_bytes",
    "failure_cut",
    "signer_key_generation",
    "signature_algorithm",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "nq.c2_global_refusal.v1"
    },
    "schema_version": {
      "const": 1
    },
    "refusal_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "physical_store_generation_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_lifecycle_root_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "host_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "role_manifest_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "authority_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "signer_scope_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_scope_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "active_store_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessor_g_root_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessor_g_cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "failure_class": {
      "enum": [
        "custody_budget_or_write_refusal",
        "failed_candidate_carrier_allocation",
        "store_pressure_or_write_fence",
        "capacity_reconciliation_failure"
      ]
    },
    "bounded_canonical_failure_bytes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "contentEncoding": "base64"
    },
    "failure_cut": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "signer_key_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "signature_algorithm": {
      "const": "ed25519"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
