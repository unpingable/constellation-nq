{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.c2_store_integrity_recovery_grant.v1.json",
  "title": "nq.c2_store_integrity_recovery_grant.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "recovery_grant_identity",
    "recovery_request_schema",
    "recovery_request_version",
    "recovery_request_identity",
    "issuer_a1_digest",
    "issuer_a1_key_generation",
    "issuer_a1_verification_key",
    "issuer_operator_principal",
    "issuer_domain",
    "issuer_permitted_scope",
    "issuer_policy_version",
    "issuer_policy_floor",
    "issued_against_gen4_cut",
    "issued_against_gen4_terminal_event",
    "issued_against_candidate_set",
    "occurrence_id",
    "a2_chain_root",
    "controlling_activation",
    "resident_identity",
    "resident_generation",
    "host_role",
    "role_manifest_generation",
    "trust_anchor_id",
    "authority_domain",
    "activation_policy_version",
    "physical_store_generation_identity",
    "signer_lifecycle_root_identity",
    "scope_identity",
    "active_store_policy_identity",
    "active_store_policy_generation",
    "proposed_effect_cut",
    "signature_algorithm",
    "signature_domain",
    "signature",
    "recovery_predecessor_binding_identity",
    "predecessor_enrollment_identity",
    "predecessor_public_key",
    "predecessor_key_generation",
    "predecessor_standing_identity",
    "predecessor_status",
    "last_completed_lifecycle_receipt_identity",
    "successor_proposal_identity",
    "successor_custody_binding_identity",
    "successor_public_key",
    "successor_key_generation",
    "successor_pop_challenge_identity",
    "successor_pop_family",
    "recovery_successor_projection_identity",
    "disposition"
  ],
  "properties": {
    "schema": {
      "const": "nq.c2_store_integrity_recovery_grant.v1"
    },
    "schema_version": {
      "const": 1
    },
    "recovery_grant_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recovery_request_schema": {
      "const": "nq.c2_store_integrity_recovery_request.v1"
    },
    "recovery_request_version": {
      "const": 1
    },
    "recovery_request_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuer_a1_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuer_a1_key_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issuer_a1_verification_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuer_operator_principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "issuer_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "issuer_permitted_scope": {
      "const": "runtime_dependency_admission"
    },
    "issuer_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issuer_policy_floor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issued_against_gen4_cut": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "issued_against_gen4_terminal_event": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issued_against_candidate_set": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "a2_chain_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "controlling_activation": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "host_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "role_manifest_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "trust_anchor_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "activation_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "physical_store_generation_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_lifecycle_root_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "active_store_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "active_store_policy_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "proposed_effect_cut": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "signature_algorithm": {
      "const": "ed25519"
    },
    "signature_domain": {
      "const": "nq.c2.store_integrity_recovery_grant.a1_signature.v1"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "recovery_predecessor_binding_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessor_enrollment_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessor_public_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "predecessor_key_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "predecessor_standing_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessor_status": {
      "enum": [
        "active_lost",
        "inactive_revoked"
      ]
    },
    "last_completed_lifecycle_receipt_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "successor_proposal_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "successor_custody_binding_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "successor_public_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "successor_key_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "successor_pop_challenge_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "successor_pop_family": {
      "const": "nq.c2_store_integrity_successor_pop.v1"
    },
    "recovery_successor_projection_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "disposition": {
      "const": "recovery_authorized"
    }
  }
}
