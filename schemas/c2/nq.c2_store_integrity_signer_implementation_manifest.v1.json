{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.c2_store_integrity_signer_implementation_manifest.v1.json",
  "title": "nq.c2_store_integrity_signer_implementation_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity_domain",
    "custody_format_identity",
    "signer_message_contract_identity",
    "source_files",
    "cryptographic_backend_identity",
    "toolchain_identity",
    "target_profile_identity",
    "qualification_assumption_identities",
    "manifest_identity"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "properties": {
    "schema": {
      "const": "nq.c2_store_integrity_signer_implementation_manifest.v1"
    },
    "identity_domain": {
      "const": "nq.c2.store_integrity_signer.implementation_manifest.v1"
    },
    "custody_format_identity": {
      "$ref": "#/$defs/digest"
    },
    "signer_message_contract_identity": {
      "$ref": "#/$defs/digest"
    },
    "source_files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/digest"
      }
    },
    "cryptographic_backend_identity": {
      "$ref": "#/$defs/digest"
    },
    "toolchain_identity": {
      "$ref": "#/$defs/digest"
    },
    "target_profile_identity": {
      "$ref": "#/$defs/digest"
    },
    "qualification_assumption_identities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "manifest_identity": {
      "$ref": "#/$defs/digest"
    }
  }
}
