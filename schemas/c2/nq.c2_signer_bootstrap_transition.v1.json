{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nq.local/schemas/nq.c2_signer_bootstrap_transition.v1.json",
  "title": "nq.c2_signer_bootstrap_transition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "transition_identity",
    "bootstrap_grant_identity",
    "enrollment_candidate_identity",
    "enrollment_identity",
    "initial_pop_identity",
    "install_policy_identity",
    "occurrence_id",
    "physical_store_generation_identity",
    "signer_lifecycle_root_identity",
    "scope_identity",
    "resident_identity",
    "resident_generation",
    "host_role",
    "role_manifest_generation",
    "authority_domain",
    "signer_scope_policy_identity",
    "signer_scope_policy_version",
    "transition_cut",
    "signed"
  ],
  "properties": {
    "schema": {
      "const": "nq.c2_signer_bootstrap_transition.v1"
    },
    "schema_version": {
      "const": 1
    },
    "transition_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bootstrap_grant_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "enrollment_candidate_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "enrollment_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "initial_pop_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "install_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "physical_store_generation_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_lifecycle_root_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resident_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "resident_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "host_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "role_manifest_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "authority_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "signer_scope_policy_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_scope_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "transition_cut": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "signed": {
      "const": false
    }
  }
}
